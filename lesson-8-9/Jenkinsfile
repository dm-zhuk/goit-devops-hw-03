pipeline {
  agent {
    kubernetes {
      yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: kaniko
    image: gcr.io/kaniko-project/executor:v1.16.0-debug
    imagePullPolicy: Always
    command: ["sleep"]
    args: ["99d"]
    env:
    - name: DOCKER_CONFIG
      value: /workspace/.docker
  - name: git
    image: alpine/git
    command: ["sleep"]
    args: ["99d"]
'''
    }
  }

  environment {
    REGISTRY = "829703038395.dkr.ecr.eu-west-1.amazonaws.com"
    REPO_NAME = "lesson-8-9-ecr"
    IMAGE_TAG = "${env.BUILD_NUMBER}"
  }

  stages {
    stage('Build & Push') {
      steps {
        container('kaniko') {
          withEnv(['AWS_REGION=eu-west-1', 'AWS_DEFAULT_REGION=eu-west-1']) {
            sh """
              mkdir -p /kaniko/.docker
              echo '{"credsStore":"ecr-login"}' > /kaniko/.docker/config.json
              /kaniko/executor \
                --context ${WORKSPACE}/lesson-8-9 \
                --dockerfile ${WORKSPACE}/lesson-8-9/Dockerfile \
                --destination ${REGISTRY}/${REPO_NAME}:${IMAGE_TAG} \
                --destination ${REGISTRY}/${REPO_NAME}:latest \
                --cache=true
            """
          }
        }
      }
    }

    stage('Update Git') {
      steps {
        container('git') {
          withCredentials([usernamePassword(credentialsId: 'github-pat', usernameVariable: 'U', passwordVariable: 'P')]) {
            sh """
              git config --global user.email "jenkins@ci"
              git config --global user.name "jenkins"
              git clone https://\$U:\$P@github.com/dm-zhuk/goit-devops-hw-03.git temp_repo
              cd temp_repo
              git checkout lesson-8-9
              sed -i "s|tag: .*|tag: '${IMAGE_TAG}'|" lesson-8-9/charts/django-app/values.yaml
              git add .
              git commit -m "update tag ${IMAGE_TAG} [ci skip]" || true
              git push origin lesson-8-9
            """
          }
        }
      }
    }
  }
}